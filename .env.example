# ─────────────────────────────────────────────────────────────
# LinkedIn AI Content System — Environment Variables
# Copy this file to .env and fill in all values before running.
# ─────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Supabase ───────────────────────────────────────────────────
# Get from: app.supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # Never use anon key here

# ── Encryption ────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Losing this key makes all stored API keys unrecoverable.
FERNET_SECRET_KEY=your-fernet-key-here

# ── Redis + Celery ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Telegram ──────────────────────────────────────────────────
# Bot token from @BotFather. Webhook secret: any random string (min 32 chars).
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-32-char-secret-here

# ── WhatsApp Cloud API ────────────────────────────────────────
# From Meta Developer Console → your app → WhatsApp → API Setup
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=any-string-you-choose-for-webhook-verification

# ── OAuth Callback ────────────────────────────────────────────
# Your public server URL (used as Zernio OAuth redirect_url)
# Local dev: use ngrok → ngrok http 8000 → copy https URL
OAUTH_CALLBACK_BASE_URL=https://your-ngrok-or-domain.com
